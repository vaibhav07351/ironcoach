# development | production (production skips loading a .env file inside the process;
# Docker Compose still injects vars via env_file)
ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/ironcoach?retryWrites=true&w=majority
# Database name (optional, default "ironcoach").
MONGODB_DB=
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Google OAuth client IDs allowed as ID token audience. Each may hold one id or a
# comma-separated list.
GOOGLE_CLIENT_ID=your-web-or-android-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup.html). DEMO_KEY works with low rate limits.
USDA_API_KEY=DEMO_KEY
# Proxies trusted to set X-Forwarded-For (comma-separated IPs/CIDRs). Default: localhost and
# private networks (Caddy on the Docker network). Never add public ranges.
TRUSTED_PROXIES=
# Browser origins allowed by CORS (Expo web build only; the mobile app does not use CORS).
CORS_ALLOWED_ORIGINS=https://ironcoach.expo.app
# App versions for the in-app "please update" gate (GET /config).
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
