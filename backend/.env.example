# development | production (production skips loading a .env file inside the process;
# Docker Compose still injects vars via env_file)
ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/ironcoach?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Google OAuth client IDs (comma-separated allowed audiences for ID token verify)
GOOGLE_CLIENT_ID=your-web-or-android-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_EXPO_CLIENT_ID=
