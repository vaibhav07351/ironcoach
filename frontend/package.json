    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.26.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
