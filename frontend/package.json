{
  "name": "frontend",
  "main": "expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1&& expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1&& expo run:android",
    "ios": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1&& expo run:ios",
    "web": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1&& expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-community/checkbox",
          "react-native-vector-icons"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
